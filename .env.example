# ===========================================================
# Monitor de Preços — variáveis de ambiente
# Copie para ".env" e preencha. NUNCA faça commit do .env!
# ===========================================================

# --- Geral --------------------------------------------------
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Supabase -----------------------------------------------
# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use a chave "service_role" (secreta, apenas no backend).
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key

# --- E-mail (Gmail via SMTP) --------------------------------
# Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Remetente exibido (opcional). Padrão: "Monitor de Preços <SMTP_USER>"
EMAIL_FROM=
# Destinatário dos alertas (pode ser o seu próprio e-mail)
EMAIL_TO=seu-email@gmail.com

# --- Agendamento (modo daemon: npm start) --------------------
# Padrão: a cada 6 horas. Fuso: America/Sao_Paulo
CRON_SCHEDULE=0 */6 * * *

# --- Regras de alerta ----------------------------------------
# Queda mínima em relação à média dos últimos 30 dias (0.10 = 10%)
ALERT_DROP_THRESHOLD=0.10
# Nº mínimo de coletas no histórico antes de comparar com a média
ALERT_MIN_SAMPLES=5
# Não repete o mesmo tipo de alerta para o mesmo produto dentro deste período
ALERT_COOLDOWN_HOURS=24

# --- Scraper -------------------------------------------------
SCRAPER_CONCURRENCY=2
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=4000
SCRAPER_TIMEOUT_MS=20000
SCRAPER_MAX_RETRIES=2
